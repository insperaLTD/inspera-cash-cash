# Copy this to .env and fill in the values. Never commit .env.

# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=

# JWT secret — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=

# Used once to create the manager account when the users table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=מנהל ראשי

# Node environment
NODE_ENV=production

# Port (Railway sets this automatically)
PORT=3000

# Allowed frontend URL (set to your Railway frontend URL after deploy)
# Use * during development
FRONTEND_URL=https://your-frontend.railway.app
